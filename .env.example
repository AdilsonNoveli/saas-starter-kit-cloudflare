# =============================================================================
# NuxFire — variáveis de ambiente para produção
# =============================================================================
# Este projeto roda 100% em Cloudflare Workers, provisionado via SST v4
# (infra/*.ts), usando sst.cloudflare.Worker nativo ponta a ponta — sem
# wrangler.toml, sem wrangler.json gerado na mão, sem deploy via CLI do
# wrangler por fora do SST.
#
# Único caminho de configuração: preencha este arquivo como `.env` local e
# carregue no cofre de secrets do próprio SST:
#
#   cp .env.example .env
#   # preencha .env com os valores reais
#   bunx sst secret load .env --stage <stage>
#   rm .env
#
# Nunca commite o arquivo `.env` real — apenas este `.env.example`.
# =============================================================================


# -----------------------------------------------------------------------------
# Autenticação da SST com a Cloudflare (obrigatório, TODA execução)
# -----------------------------------------------------------------------------
# Estas duas NÃO podem ficar só guardadas como secret do SST — o SST exige as
# duas como variável de ambiente REAL em todo comando (`secret load`,
# `secret set`, `deploy`, `dev`...), porque é essa credencial que autentica o
# próprio SST na Cloudflare antes de conseguir ler qualquer coisa do cofre.
# Exporte no terminal antes de qualquer comando `sst`/`bun run deploy`:
#   PowerShell: $env:CLOUDFLARE_API_TOKEN = "..."
#   bash/zsh:   export CLOUDFLARE_API_TOKEN=...

# Token de API da Cloudflare usado pelo provider `cloudflare` da SST para
# criar/atualizar Workers, Hyperdrive, KV, R2, Queues, Durable Objects e
# rotas de domínio. Crie em https://dash.cloudflare.com/profile/api-tokens —
# veja guia-rapido.md para as permissões exatas.
CLOUDFLARE_API_TOKEN=

# ID da conta Cloudflare (obrigatório se o token tiver acesso a mais de uma
# conta). Encontrado no painel da Cloudflare, na barra lateral direita.
CLOUDFLARE_ACCOUNT_ID=


# -----------------------------------------------------------------------------
# Banco de dados — PostgreSQL (acessado via Cloudflare Hyperdrive)
# -----------------------------------------------------------------------------
# Qualquer Postgres padrão funciona (Supabase, RDS, Neon, self-hosted...).
# A conexão é sempre via protocolo Postgres nativo — nunca via SDK
# proprietário de um provedor. A extensão `postgis` precisa estar habilitada
# no banco (Supabase já vem com ela disponível).

# Usadas pelo Hyperdrive (infra/database.ts, conexão real dos Workers) e
# também pelo `drizzle-kit` (CLI local/migrations — packages/functions/drizzle.config.ts
# aceita host/port/user/password/database separados, não precisa montar URL).
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=


# -----------------------------------------------------------------------------
# Secrets do SST — provedores de email (config.ts -> flags)
# -----------------------------------------------------------------------------
# Ative/desative provedores em config.ts. Hoje: resend=true, demais=false.

# Resend (flags.resend)
RESEND_API_KEY=

# Mailgun (flags.mailgun)
MAILGUN_API_KEY=

# AWS SES (flags.ses) — TODO em infra/secret.ts: IAM ainda não é IaC
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SparkPost (flags.sparkPost)
SPARKPOST_API_KEY=

# SMTP genérico (flags.smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=


# -----------------------------------------------------------------------------
# Secrets do SST — login social (config.ts -> flags)
# -----------------------------------------------------------------------------

# GitHub OAuth (flags.githubAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (flags.googleAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Secrets do SST — pagamentos (config.ts -> flags)
# -----------------------------------------------------------------------------

# Stripe (flags.stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# Paddle (flags.paddle)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token for Paddle.js — public by design (ends up in
# NUXT_PUBLIC_PADDLE_CLIENT_TOKEN, see infra/app.ts), but still per-stage.
# Without it, use-payments.ts refuses to initialize Paddle checkout.
PADDLE_CLIENT_TOKEN=


# -----------------------------------------------------------------------------
# Secrets do SST — console de platform admin (/admin)
# -----------------------------------------------------------------------------
# Os dois são obrigatórios antes de qualquer rota /admin/* funcionar: sem eles
# o servidor falha fechado (não degrada para um modo inseguro). São
# operator-managed, não gerados por deploy — a chave de criptografia em
# particular protege segredos TOTP já gravados no banco, e perdê-la obriga todo
# platform admin a se cadastrar de novo. Gere cada um com:
#
#   openssl rand -base64 32
#
# Server-only (viram NUXT_PLATFORM_* em infra/app.ts, nunca NUXT_PUBLIC_*).

# Sela o cookie de sessão elevada de 30 minutos do MFA
# (packages/app/server/utils/platform-mfa-session.ts). Mínimo de 32 caracteres.
PLATFORM_MFA_SESSION_SECRET=

# Criptografa (AES-GCM) o segredo TOTP de cada platform admin em repouso
# (packages/app/server/utils/mfa-crypto.ts). Deliberadamente separado do
# anterior: aquele pode ser rotacionado a qualquer momento, este não —
# rotacioná-lo invalida o MFA de todos os admins já cadastrados.
PLATFORM_ADMIN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Secrets do SST — 2FA opcional de usuário comum (Account Settings > Security)
# -----------------------------------------------------------------------------
# Mesmo par de secrets do platform admin acima, mesma regra (obrigatórios
# antes do usuário conseguir ativar 2FA; sem eles a rota falha fechado) — só
# que deliberadamente separados: rotacionar um dos pares não deve afetar o
# MFA da outra população, e uma instalação que só quer 2FA de usuário comum
# não deveria precisar configurar o par do console admin. Gere cada um com:
#
#   openssl rand -base64 32

# Sela o cookie de sessão verificada do usuário (uma verificação por login,
# não expira a cada 30 min como a do admin — ver
# packages/app/server/utils/user-mfa-session.ts). Mínimo de 32 caracteres.
USER_MFA_SESSION_SECRET=

# Criptografa (AES-GCM) o segredo TOTP de cada usuário em repouso
# (packages/app/server/utils/mfa-crypto.ts).
USER_MFA_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Opcional — apenas build/dev local
# -----------------------------------------------------------------------------

# Limita quantos pacotes a SST builda em paralelo (útil em CI com pouca CPU).
SST_BUILD_CONCURRENCY_SITE=1


# -----------------------------------------------------------------------------
# NÃO vai aqui: NUXT_PUBLIC_*, URLs de app/auth/websockets, client IDs, etc.
# São derivados automaticamente pela infra (infra/*.ts) a cada deploy —
# nunca configurados manualmente.
#
# Exceção de uso pontual: o script MANUAL de contas de demonstração
# (packages/functions/src/database/seed-demo-accounts.ts) roda fora do Worker e
# por isso precisa receber duas dessas variáveis derivadas no ambiente do
# terminal, na hora de rodar — não neste arquivo, e não no cofre do SST:
#
#   AUTH_URL           = a URL pública do Worker de auth já deployado, o mesmo
#                        valor que infra/app.ts passa ao app como
#                        NUXT_PUBLIC_AUTH_URL (aceito como alias pelo script).
#   AUTH_ADMIN_SECRET  = o segredo compartilhado que protege as rotas
#                        /internal/identity/*. Gerado por deploy em
#                        infra/auth.ts (`adminSecret`, random.RandomUuid) e
#                        entregue ao app como NUXT_AUTH_ADMIN_SECRET (também
#                        aceito como alias). Leia-o das variáveis do Worker do
#                        app já deployado.
# -----------------------------------------------------------------------------
