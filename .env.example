# =============================================================================
# Nuxfire — environment variables
# =============================================================================
# This project runs 100% on Cloudflare Workers, provisioned with SST v4
# (infra/*.ts) using native sst.cloudflare.Worker end to end — no
# wrangler.toml, no hand-written wrangler.json, no wrangler CLI deploy outside
# of SST.
#
# One way to configure it: one file per stage, filled in locally and loaded
# into SST's own secrets vault:
#
#   Development (any stage that is not production):
#     cp .env.example .env.stage
#     # fill in .env.stage with the real values
#     bunx sst secret load .env.stage --fallback
#
#   Production (its own file, with its own values, WITHOUT --fallback):
#     cp .env.example .env.production
#     # fill in .env.production with the real values
#     bunx sst secret load .env.production --stage production
#
# Keep .env.stage / .env.production locally (.gitignore already excludes them):
# you will need them again whenever a secret changes. Never commit those
# files — only this `.env.example`.
#
# Full walkthrough: https://nuxfire.com/docs/saas-starter-kit/getting-started/quick-start
# Before deploying, `bun run doctor` checks what usually goes wrong.
# =============================================================================


# -----------------------------------------------------------------------------
# Branding — the installation's identity (required)
# -----------------------------------------------------------------------------
# The only place where you set your domain and your sender e-mail. Everything
# else (the app./auth./websockets. domains, the e-mails' sender and logo)
# derives from here — no code file holds an equivalent value.
#
# Unlike the credentials below, these values are NOT secrets: the deploy reads
# them straight from this file (scripts/branding.ts). There is deliberately no
# default: if one is missing or malformed, the deploy stops and tells you which
# variable to fix.
# Each stage reads ITS OWN file (.env.production for production, .env.stage for
# every other stage) — fill in the same domain in both unless you have a reason
# to differ. A real environment variable with the same name takes precedence (CI).

# Your product or company name: the e-mails' sender name, subject lines and logo.
BRAND_NAME=

# Production domain, the bare name only (acme.io) — no https://, path or port. It
# must be an active zone in the SAME Cloudflare account as the token. The
# `production` stage answers on it; every other stage answers on
# <stage>.dev.<domain>.
BRAND_DOMAIN=

# COMPLETE sender address (contact@acme.io) — the address only, the display name
# comes from BRAND_NAME. Its domain must be verified in your e-mail provider
# (Resend, Mailgun, SES...); it may be a subdomain.
BRAND_EMAIL=


# -----------------------------------------------------------------------------
# SST authentication with Cloudflare (required, on EVERY run)
# -----------------------------------------------------------------------------
# These two can NOT live only as SST secrets — SST needs both as REAL
# environment variables on every command (`secret load`, `secret set`,
# `deploy`, `dev`...), because this credential is what authenticates SST to
# Cloudflare before it can read anything from the vault.
# Export them in the terminal before any `sst` / `bun run deploy` command:
#   PowerShell: $env:CLOUDFLARE_API_TOKEN = "..."
#   bash/zsh:   export CLOUDFLARE_API_TOKEN=...

# Cloudflare API token used by SST's `cloudflare` provider to create/update
# Workers, Hyperdrive, KV, R2, Queues, Durable Objects and domain routes.
# Create an ACCOUNT API TOKEN (dashboard: Manage Account → Account API Tokens —
# not the personal tokens page of your profile). The exact permissions are at:
# https://nuxfire.com/docs/saas-starter-kit/getting-started/cloudflare-access
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (required if the token has access to more than one
# account). In the Cloudflare dashboard: the ⋮ menu next to your account name →
# Copy Account ID.
CLOUDFLARE_ACCOUNT_ID=


# -----------------------------------------------------------------------------
# Database — PostgreSQL (reached through Cloudflare Hyperdrive)
# -----------------------------------------------------------------------------
# Any standard Postgres works (Supabase, RDS, Neon, self-hosted...).
# The connection is always over the native Postgres protocol — never through a
# provider's proprietary SDK. The `postgis` extension must be enabled on the
# database (Supabase ships with it available).

# Used by Hyperdrive (infra/database.ts, the Workers' real connection) and also
# by `drizzle-kit` (local CLI/migrations — apps/functions/drizzle.config.ts
# takes host/port/user/password/database separately, no URL to assemble).
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=


# -----------------------------------------------------------------------------
# SST secrets — e-mail providers (config.ts -> flags)
# -----------------------------------------------------------------------------
# Enable/disable providers in config.ts. Today: resend=true, the rest=false.

# Resend (flags.resend)
RESEND_API_KEY=

# Mailgun (flags.mailgun)
MAILGUN_API_KEY=

# AWS SES (flags.ses) — TODO in infra/secret.ts: IAM is not IaC yet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SparkPost (flags.sparkPost)
SPARKPOST_API_KEY=

# Generic SMTP (flags.smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=


# -----------------------------------------------------------------------------
# SST secrets — social login (config.ts -> flags)
# -----------------------------------------------------------------------------

# GitHub OAuth (flags.githubAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (flags.googleAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# SST secrets — payments (config.ts -> flags)
# -----------------------------------------------------------------------------

# Stripe (flags.stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# Paddle (flags.paddle)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token for Paddle.js — public by design (ends up in
# NUXT_PUBLIC_PADDLE_CLIENT_TOKEN, see infra/app.ts), but still per-stage.
# Without it, use-payments.ts refuses to initialize Paddle checkout.
PADDLE_CLIENT_TOKEN=


# -----------------------------------------------------------------------------
# SST secrets — platform admin console (/admin)
# -----------------------------------------------------------------------------
# Both are required before any /admin/* route works: without them the server
# fails closed (it does not degrade to an insecure mode). They are
# operator-managed, not generated per deploy — the encryption key in particular
# protects TOTP secrets already stored in the database, and losing it forces
# every platform admin to enroll again. Generate each one with:
#
#   openssl rand -base64 32
#
# Server-only (they become NUXT_PLATFORM_* in infra/app.ts, never NUXT_PUBLIC_*).

# Seals the MFA's 30-minute elevated-session cookie
# (layers/admin/server/utils/platform-mfa-session.ts). At least 32 characters.
PLATFORM_MFA_SESSION_SECRET=

# Encrypts (AES-GCM) each platform admin's TOTP secret at rest
# (apps/app/server/utils/mfa-crypto.ts). Deliberately separate from the
# previous one: that one can be rotated at any time, this one cannot —
# rotating it invalidates the MFA of every admin already enrolled.
PLATFORM_ADMIN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# SST secrets — optional 2FA for regular users (Account Settings > Security)
# -----------------------------------------------------------------------------
# The same pair of secrets as the platform admin above, with the same rule
# (required before a user can turn 2FA on; without them the route fails closed)
# — but deliberately separate: rotating one pair must not affect the MFA of the
# other population, and an installation that only wants regular-user 2FA should
# not have to configure the admin console's pair. Generate each one with:
#
#   openssl rand -base64 32

# Seals the user's verified-session cookie (one verification per login, it does
# not expire every 30 min like the admin's — see
# apps/app/server/utils/user-mfa-session.ts). At least 32 characters.
USER_MFA_SESSION_SECRET=

# Encrypts (AES-GCM) each user's TOTP secret at rest
# (apps/app/server/utils/mfa-crypto.ts).
USER_MFA_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Optional — local build/dev only
# -----------------------------------------------------------------------------

# Limits how many packages SST builds in parallel (useful on low-CPU CI).
SST_BUILD_CONCURRENCY_SITE=1


# -----------------------------------------------------------------------------
# Does NOT go here: NUXT_PUBLIC_*, app/auth/websockets URLs, client IDs, etc.
# They are derived automatically by the infrastructure (infra/*.ts) on every
# deploy — never configured by hand.
#
# One-off exception: the MANUAL demo-accounts script
# (apps/functions/src/database/seed/demo-accounts.ts) runs outside the Worker
# and therefore needs two of those derived variables in the terminal's
# environment at the time you run it — not in this file, and not in SST's vault:
#
#   AUTH_URL           = the public URL of the already deployed auth Worker, the
#                        same value infra/app.ts hands to the app as
#                        NUXT_PUBLIC_AUTH_URL (accepted as an alias by the script).
#   AUTH_ADMIN_SECRET  = the shared secret that protects the
#                        /internal/identity/* routes. Generated per deploy in
#                        infra/auth.ts (`adminSecret`, random.RandomUuid) and
#                        handed to the app as NUXT_AUTH_ADMIN_SECRET (also
#                        accepted as an alias). Read it from the variables of
#                        the already deployed app Worker.
# -----------------------------------------------------------------------------
