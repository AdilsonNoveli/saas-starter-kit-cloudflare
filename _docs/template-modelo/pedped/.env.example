# ===== SUPABASE CONFIG =====
# Prefixo NUXT_PUBLIC_ é o nome canônico: o @nuxtjs/supabase lê no build E o
# Nitro injeta no runtimeConfig.public.supabase em runtime (funciona em dev,
# Docker e Cloudflare Workers). Sem o prefixo, só valeria no build.
NUXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NUXT_PUBLIC_SUPABASE_KEY="sb_publishable_sua_chave_publica_aqui"
NUXT_SUPABASE_SECRET_KEY="sb_secret_sua_secret_key_aqui"

# ===== URL PÚBLICA DA APLICAÇÃO =====
# URL base de todo link gerado pela aplicação (catálogo do agente, convites, webhooks)
NUXT_SITE_URL="https://seu-dominio.com"

# ===== CLOUDFLARE WORKERS =====
# Nome desta instalação: prefixo das filas isoladas (scripts/ensure-cf-queues.mjs).
# Cada cliente é um fork deste repo com seu próprio Worker — este valor deve
# bater com o `name` do wrangler.toml DAQUELE fork e com o nome do Worker
# cadastrado no dashboard Cloudflare da conta dele (ver cloudflare/README.md).
CLOUDFLARE_WORKER_NAME="pedped"

# ===== GOOGLE MAPS PLATFORM (KEY SPLIT / BFF) =====
# 1) CHAVE PÚBLICA (browser - Maps JavaScript API)
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSy...publica..."
# 2) CHAVE PRIVADA (server-only - Places API, Geocoding API, Routes API)
NUXT_GOOGLE_MAPS_SERVER_KEY="AIzaSy...privada..."

# ===== TOKENS DE SEGURANÇA E INTEGRAÇÃO =====
# NOTA: o token e a chave de assinatura do webhook de SAÍDA não são variáveis
# de ambiente. Ficam no Supabase Vault e são configurados na própria aplicação,
# em Configurações → Webhooks (migration 103).
# Secret token para cron jobs internos (archive-orders, outbox worker)
NUXT_WORKER_TOKEN="seu-token-de-worker-aqui"

# ===== AGENTE WHATSAPP (in-app) =====
# Token da API de SAÍDA do WhatsApp (envio, marcar como lida, "digitando")
NUXT_WHATSAPP_API_TOKEN="seu-token-de-saida-whatsapp-aqui"
# Token imprevisível embutido no path da URL do webhook do WhatsApp
NUXT_WHATSAPP_WEBHOOK_TOKEN="seu-token-de-webhook-whatsapp-aqui"

# ===== JWT CONFIG =====
NUXT_JWT_SECRET="seu-jwt-secret-aqui"

# ===== STORAGE S3 (Cloudflare R2 / Backblaze B2 / AWS S3) =====
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=sua-access-key
S3_SECRET_ACCESS_KEY=sua-secret-key
S3_FORCE_PATH_STYLE=false
S3_AVATAR_BUCKET_NAME=nome-do-bucket
S3_ATTACHMENTS_BUCKET_NAME=nome-do-bucket
S3_PUBLIC_URL=https://files.seu-dominio.com