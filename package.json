{
  "name": "nuxfire",
  "version": "0.0.0",
  "scripts": {
    "doctor": "bun scripts/doctor.ts",
    "deploy": "bun scripts/deploy.ts",
    "format": "prettier -w .",
    "test": "vitest run",
    "check:i18n": "bun scripts/check-i18n-completeness.ts && bun scripts/check-docs-translations.ts",
    "fireskill": "bun fireskills/cli/src/main.ts",
    "web": "sst shell -- bun scripts/dev.ts web",
    "web-remote": "sst shell -- bun scripts/dev.ts web remote",
    "app": "sst shell -- bun scripts/dev.ts app",
    "app-remote": "sst shell -- bun scripts/dev.ts app remote"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "layers/*"
  ],
  "devDependencies": {
    "@tsconfig/node22": "^22",
    "prettier": "^3.4.2",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/bun": "^1.2.0",
    "sst": "4.14.0",
    "unenv": "2.0.0-rc.24"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "tar": "^7.5.22",
    "glob": "^10.5.0",
    "sharp": "^0.35.0",
    "svgo": "^3.3.4",
    "esbuild": "0.25.12",
    "nodemailer": "9.1.1",
    "maplibre-gl": "6.9.0",
    "prismjs": "1.30.0"
  },
  "patchedDependencies": {
    "nodemailer@9.1.1": "patches/nodemailer@9.1.1.patch",
    "@openauthjs/openauth@0.3.9": "patches/@openauthjs%2Fopenauth@0.3.9.patch"
  },
  "trustedDependencies": [
    "@nuxfire/app",
    "@nuxfire/login",
    "@nuxfire/web",
    "@parcel/watcher",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi",
    "workerd"
  ]
}
